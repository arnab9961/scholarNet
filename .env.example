# ==============================================================================
# SCHOLARNET / RESEARCH COMMUNITY CONFIGURATION
# ==============================================================================
# Provide your Supabase project credentials below.
# You can find these in your Supabase Dashboard -> Project Settings -> API.
# If left blank or placeholder, the application automatically uses local storage
# so you can test immediately without any errors.

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (Project Settings -> API -> anon/public key)
SUPABASE_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Optional: for administrative or storage tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Supabase Storage Bucket for Profile Avatars (Default: "avatars")
SUPABASE_STORAGE_BUCKET=avatars

# ==============================================================================
# SECURITY & AUTHENTICATION CONFIGURATION
# ==============================================================================
# Secret key used to sign JWT access tokens.
JWT_SECRET=scholarnet_super_secret_jwt_key_2026_academic_community_auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
HOST=127.0.0.1
PORT=8000
APP_ENV=development
DEBUG=True
